{
  "name": "fugluck",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm --workspace=@fugluck/client run build",
    "build:client": "npm --workspace=@fugluck/client run build",
    "build:server": "tsc --project packages/server/tsconfig.json --noEmit",
    "start:server": "npm --workspace=@fugluck/server run start",
    "db:migrate": "npm --workspace=@fugluck/server run db:migrate",
    "typecheck": "tsc --project packages/shared/tsconfig.json --noEmit && tsc --project packages/theme/tsconfig.json --noEmit && tsc --project games/tsconfig.json --noEmit && tsc --project packages/server/tsconfig.json --noEmit && npm run typecheck:tooling && npm --workspace=@fugluck/client run build",
    "test:database-safety": "tsx scripts/test-database-safety-check.ts",
    "test:migration-parity": "tsx scripts/migration-schema-parity-check.ts",
    "test:competition-domain": "tsx scripts/competition-phase1-domain-check.ts",
    "test:competition-accounting": "tsx scripts/competition-phase2-accounting-check.ts",
    "test:competition-lifecycle": "tsx scripts/competition-phase3-lifecycle-check.ts",
    "test:competition-player-ui": "tsx scripts/competition-phase4-ui-check.ts",
    "test:competition-player-ux": "tsx scripts/competition-player-ux-check.ts",
    "test:competition-admin": "tsx scripts/competition-phase5-admin-check.ts",
    "test:atomic-wager": "tsx scripts/atomic-wager-lifecycle-check.ts",
    "test": "node scripts/run-regression.mjs",
    "test:competition-authority": "tsx scripts/competition-authority-check.ts",
    "test:cyber-hopper-authority": "tsx scripts/cyber-hopper-authority-check.ts",
    "test:authority-latency": "tsx scripts/competition-authority-latency-check.ts",
    "test:competition-admin-http": "tsx scripts/competition-admin-http-check.ts",
    "test:authority-presentation": "tsx scripts/authority-presentation-check.ts",
    "test:environment-safety": "tsx scripts/environment-safety-check.ts",
    "test:staging-mock-commercial": "tsx scripts/staging-mock-commercial-check.ts",
    "audit:environment": "tsx scripts/environment-baseline.ts",
    "test:tournament-rules": "tsx scripts/tournament-rules-check.ts",
    "test:tournament-domain": "tsx scripts/tournament-domain-check.ts",
    "test:tournament-recovery": "tsx scripts/tournament-recovery-check.ts",
    "test:tournament-authority": "tsx scripts/tournament-authority-check.ts",
    "test:security": "tsx scripts/security-boundary-check.ts",
    "test:proxy-rate-limit": "tsx scripts/proxy-rate-limit-check.ts",
    "test:read-only": "node scripts/run-regression.mjs --read-only",
    "typecheck:tooling": "tsc -p scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.21.1 <12"
  },
  "packageManager": "npm@11.21.1",
  "overrides": {
    "esbuild@~0.18.20": "0.25.12"
  },
  "workspaces": [
    "packages/*",
    "games"
  ]
}
