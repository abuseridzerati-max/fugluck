# =============================================================================
# Fugluck Frontend Client Environment Template (packages/client)
# =============================================================================
# For Local Development: Copy to packages/client/.env.local or .env
# For Staging Deployment: Set in Vercel Project Settings -> Environment Variables
#
# IMPORTANT: Never place server secrets (e.g. DATABASE_URL, JWT_SECRET) here.
# Any variable with prefix VITE_* is bundled publicly into client JavaScript.
# =============================================================================

# [REQUIRED IN STAGING] Backend API & WebSocket Server URL
# Local: http://localhost:4000
# Staging: https://api-staging.fugluck.com
VITE_API_URL=http://localhost:4000
VITE_APP_ENV=development
# Vercel Preview for the approved staging branch: VITE_APP_ENV=staging and
# VITE_API_URL=https://api-staging.fugluck.com. Scope variables to that branch.
# Production builds on Vercel require a separately accepted production target.

# Set VITE_SHOW_SANDBOX_GEL=true only when intentionally exposing simulated
# TEST / SANDBOX GEL UI controls in non-admin demo views.
VITE_SHOW_SANDBOX_GEL=false
