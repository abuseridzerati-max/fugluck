# =============================================================================
# Fugluck Frontend Client Environment Template (packages/client)
# =============================================================================
# For Local Development: Copy to packages/client/.env.local or .env
# For Staging Deployment: Set in Vercel Project Settings -> Environment Variables
#
# IMPORTANT: Never place server secrets (e.g. DATABASE_URL, JWT_SECRET) here.
# Any variable with prefix VITE_* is bundled publicly into client JavaScript.
# =============================================================================

# [REQUIRED IN STAGING] Backend API & WebSocket Server URL
# Local: http://localhost:4000
# Staging: https://api-staging.fugluck.com
VITE_API_URL=http://localhost:4000

# [OPTIONAL / PUBLIC] Supabase Client Configuration (Public RLS Anonymous Key)
# Local/Dev: Placeholder or dev Supabase instance
# Staging: https://your-staging-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
