# =============================================================================
# Fugluck Backend Server Environment Template (packages/server)
# =============================================================================
# For Local Development: Copy to packages/server/.env
# For Staging Deployment: Set in Render / Railway Environment Variables
#
# IMPORTANT: Never commit actual credentials or secrets to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (REQUIRED IN STAGING - SECRET)
# -----------------------------------------------------------------------------
# Dedicated PostgreSQL Connection URI for the STAGING environment.
# STAGING MUST HAVE ITS OWN SEPARATE DATABASE INSTANCE. NEVER POINT TO PROD.
# Format: postgresql://[user]:[password]@[host]:[port]/[staging_db_name]?sslmode=require
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/fugluck_staging

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION SECURITY (REQUIRED IN STAGING - SECRET)
# -----------------------------------------------------------------------------
# 64+ character random string for signing JWT HTTP-only session cookies.
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-secure-random-secret-key-64ch

# -----------------------------------------------------------------------------
# 3. HTTP SERVER & HOSTING RUNTIME (REQUIRED IN STAGING)
# -----------------------------------------------------------------------------
# Port number for the HTTP + WebSocket server.
# Local: 4000 | Render/Railway: Typically auto-injected by host ($PORT)
PORT=4000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=production

# Reverse proxy trust level (1 hop for Render / Railway / Cloudflare / Vercel)
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# 4. CORS & CROSS-SUBDOMAIN COOKIE SECURITY (REQUIRED IN STAGING)
# -----------------------------------------------------------------------------
# Primary Frontend URL allowed to make credentialed requests
CLIENT_ORIGIN=https://staging.fugluck.com

# Comma-separated list of allowed origins (for multiple preview domains)
ALLOWED_ORIGINS=https://staging.fugluck.com

# Domain for session cookie scoping (e.g. .fugluck.com allows sharing
# between staging.fugluck.com and api-staging.fugluck.com)
COOKIE_DOMAIN=.fugluck.com

# Cookie SameSite attribute: 'lax' (recommended for sibling subdomains) or 'none' (for cross-site HTTPS)
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# 5. PUBLIC APP BASE URL & TRANSACTIONAL EMAILS (REQUIRED IN STAGING)
# -----------------------------------------------------------------------------
# Base URL used when formatting email verification and password reset links
APP_URL=https://staging.fugluck.com

# Email provider: 'logger' (safe staging/dev log output) | 'resend' | 'smtp'
EMAIL_PROVIDER=logger
EMAIL_FROM=Fugluck Staging <no-reply@fugluck.com>

# Resend API Key (Optional in staging; required if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_123456789

# SMTP Configuration (Optional in staging; required if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@fugluck.com
# SMTP_PASS=secret-smtp-password
# SMTP_SECURE=false

# -----------------------------------------------------------------------------
# 6. FINANCIAL SAFETY CONTROLS (CRITICAL STAGING SAFETY)
# -----------------------------------------------------------------------------
# Gate development Diamond Shop sandbox grant button.
# In staging/production, set to 'false' to prevent un-audited token grants.
ENABLE_DEV_DIAMOND_STUB=false

# -----------------------------------------------------------------------------
# 7. LOGGING & DIAGNOSTICS (OPTIONAL)
# -----------------------------------------------------------------------------
# Enable verbose request/response diagnostics (passwords & tokens are always redacted)
VERBOSE_LOGGING=false
