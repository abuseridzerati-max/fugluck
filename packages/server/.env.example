# ArcadeClash Backend Server Environment Template
# Copy this file to packages/server/.env for local development.

# PostgreSQL Connection String (Database credentials)
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/arcadeclash_db

# Secret Key for JWT Session Token Signing (Use a 64+ char random string in production)
JWT_SECRET=replace-with-a-long-secure-random-secret-key-64ch

# HTTP Server Listening Port
PORT=4000

# Allowed CORS Client Origin
CLIENT_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development

# Public App Base URL (used in email verification & password reset links)
APP_URL=http://localhost:5173

# Transactional Email Service Configuration
# Providers: logger (default dev/test logger) | resend | smtp
EMAIL_PROVIDER=logger
EMAIL_FROM=ArcadeClash <no-reply@arcadeclash.com>

# Resend API Provider (if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_123456789

# SMTP Provider (if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@arcadeclash.com
# SMTP_PASS=secret-smtp-password
# SMTP_SECURE=false

